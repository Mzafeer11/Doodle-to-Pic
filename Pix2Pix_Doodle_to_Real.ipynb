   "source": [
    "# Pix2Pix Doodle-to-Real Image Translation\n",
    "\n",
    "**Objective:** Design and implement a paired image-to-image translation system using a conditional GAN (Pix2Pix) to convert Sketch/Edge images to Realistic images or Grayscale to Colored images.\n",
    "\n",
    "**Platform:** Kaggle (GPU T4 x2)\n",
    "**Datasets:** CUHK Face Sketch & Anime Sketch Colorization"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. Environment Setup & Data Verification\n",
    "Run this cell to set up the environment and verify dataset paths."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.utils.data import DataLoader\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "import gradio as gr\n",
    "\n",
    "# Import custom modules (ensure modular .py files are in the same directory)\n",
    "from model import UNetGenerator, PatchGANDiscriminator, init_weights\n",
    "from dataset import PairedDataset, get_transforms\n",
    "from train_utils import Pix2PixTrainer, save_checkpoint, load_checkpoint\n",
    "from eval_utils import calculate_metrics, tensor_to_numpy\n",
    "\n",
    "# Config\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "BATCH_SIZE = 16\n",
    "IMG_SIZE = 256\n",
    "LR = 0.0002\n",
    "BETAS = (0.5, 0.999)\n",
    "LAMBDA_L1 = 100\n",
    "EPOCHS = 20\n",
    "\n",
    "# Paths (Update these based on your Kaggle environment)\n",
    "CUHK_ROOT = \"/kaggle/input/cuhk-face-sketch-database-cufs/\"\n",
    "ANIME_ROOT = \"/kaggle/input/anime-sketch-colorization-pair/\"\n",
    "\n",
    "def verify_dataset(path):\n",
    "    if os.path.exists(path):\n",
    "        print(f\"✅ Dataset found at: {path}\")\n",
    "        files = os.listdir(path)\n",
    "        print(f\"   Count: {len(files)} items\")\n",
    "    else:\n",
    "        print(f\"❌ Dataset NOT found at: {path}\")\n",
    "\n",
    "verify_dataset(CUHK_ROOT)\n",
    "verify_dataset(ANIME_ROOT)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Model Initialization\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "netG = nn.DataParallel(UNetGenerator(input_nc=3, output_nc=3, num_downs=8)).to(DEVICE)\n",
    "netD = nn.DataParallel(PatchGANDiscriminator(input_nc=6)).to(DEVICE)\n",
    "\n",
    "init_weights(netG)\n",
    "init_weights(netD)\n",
    "\n",
    "print(\"Models initialized with DataParallel.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Training Loop with Checkpointing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Choose Dataset (e.g., Anime)\n",
    "train_dataset = PairedDataset(ANIME_ROOT + \"train/\", mode='combined', transform=get_transforms(IMG_SIZE))\n",
    "train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=4)\n",
    "\n",
    "optimizer_G = optim.Adam(netG.parameters(), lr=LR, betas=BETAS)\n",
    "optimizer_D = optim.Adam(netD.parameters(), lr=LR, betas=BETAS)\n",
    "\n",
    "trainer = Pix2PixTrainer(netG, netD, optimizer_G, optimizer_D, DEVICE, lambda_l1=LAMBDA_L1)\n",
    "\n",
    "history = {'G': [], 'D': [], 'SSIM': []}\n",
    "CHECKPOINT_PATH = \"pix2pix_checkpoint.pth\"\n",
    "\n",
    "start_epoch = 0\n",
    "if os.path.exists(CHECKPOINT_PATH):\n",
    "    start_epoch = load_checkpoint(CHECKPOINT_PATH, netG, netD, optimizer_G, optimizer_D) + 1\n",
    "    print(f\"Resuming from epoch {start_epoch}\")\n",
    "\n",
    "for epoch in range(start_epoch, EPOCHS):\n",
    "    print(f\"\\n--- Epoch {epoch}/{EPOCHS} ---\")\n",
    "    epoch_metrics = []\n",
    "    for i, batch in enumerate(train_loader):\n",
    "        losses = trainer.train_step(batch['A'], batch['B'])\n",
    "        \n",
    "        if i % 100 == 0:\n",
    "            print(f\"[Batch {i}/{len(train_loader)}] Loss G: {losses['loss_G']:.4f} | Loss D: {losses['loss_D']:.4f}\")\n",
    "            \n",
    "    # Save at end of each epoch\n",
    "    save_checkpoint({\n",
    "        'epoch': epoch,\n",
    "        'state_dict_G': netG.state_dict(),\n",
    "        'state_dict_D': netD.state_dict(),\n",
    "        'optimizer_G': optimizer_G.state_dict(),\n",
    "        'optimizer_D': optimizer_D.state_dict(),\n",
    "    }, CHECKPOINT_PATH)\n",
    "    \n",
    "print(\"Training Complete and Final Checkpoint Saved.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Visualization & Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def show_samples(netG, loader, num_samples=3):\n",
    "    netG.eval()\n",
    "    batch = next(iter(loader))\n",
    "    with torch.no_grad():\n",
    "        fake_B = netG(batch['A'].to(DEVICE))\n",
    "        \n",
    "    plt.figure(figsize=(15, 5 * num_samples))\n",
    "    for i in range(num_samples):\n",
    "        # Input\n",
    "        plt.subplot(num_samples, 3, i*3 + 1)\n",
    "        plt.imshow(tensor_to_numpy(batch['A'][i]))\n",
    "        plt.title(\"Input (Sketch)\")\n",
    "        plt.axis('off')\n",
    "        \n",
    "        # Fake\n",
    "        plt.subplot(num_samples, 3, i*3 + 2)\n",
    "        plt.imshow(tensor_to_numpy(fake_B[i]))\n",
    "        plt.title(\"Generated (Real)\")\n",
    "        plt.axis('off')\n",
    "        \n",
    "        # Ground Truth\n",
    "        plt.subplot(num_samples, 3, i*3 + 3)\n",
    "        plt.imshow(tensor_to_numpy(batch['B'][i]))\n",
    "        plt.title(\"Ground Truth\")\n",
    "        plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "show_samples(netG, train_loader)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Deployment - Gradio App"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict(img):\n",
    "    transform = get_transforms(IMG_SIZE)\n",
    "    image = Image.fromarray(img).convert(\"RGB\")\n",
    "    image_tensor = transform(image).unsqueeze(0).to(DEVICE)\n",
    "    \n",
    "    netG.eval()\n",
    "    with torch.no_grad():\n",
    "        output = netG(image_tensor)\n",
    "    \n",
    "    return tensor_to_numpy(output[0])\n",
    "\n",
    "gr.Interface(fn=predict, \n",
    "             inputs=gr.Image(label=\"Upload Sketch or Grayscale Image\"), \n",
    "             outputs=gr.Image(label=\"Resulting Image\"),\n",
    "             title=\"Doodle-to-Pic Generator\").launch(share=True)"
   ]
  }
 ],
